  "_section_30": "==================== Spring Boot application pods ====================",
  "_comment_30": "branch is used only by scripts/sync-module-sources.ps1. If omitted, develop is used. gitUrl is optional and needed only when the module folder must be cloned.",
  "services": [
    {
      "name": "app1",
      "projectDir": "app1",
      "branch": "develop",
      "gitUrl": "https://github.com/example/app1.git",
      "hostPort": 40005,
      "containerPort": 8080,
      "imageTag": "local/app1:dev",
      "applicationYaml": "application-local.yaml",
      "env": {
        "SPRING_PROFILES_ACTIVE": "podman",
        "JAVA_OPTS": "-Xms256m -Xmx768m"
      }
    }
  ]
